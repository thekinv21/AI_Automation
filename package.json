		"prepare": "husky"
	},
	"dependencies": {
		"next": "16.4.3",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@tailwindcss/turbopack": "^4",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.4.3",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-boundaries": "^7.4.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.10",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"packageManager": "bun@1.4.0",
	"ignoreScripts": [
		"sharp",
