{
	"name": "ai_automation",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"format": "prettier --write \"{app,src}/**/*.{ts,tsx}\"",
